{
  // IntelliSense 設定。includePath 直接指向 include/，因此不依賴任何建置產物即可解析標頭。
  // 若已用 ninja preset 建置過，compileCommands 會提供更精確的旗標（含 /utf-8），
  // 檔案不存在時 VS Code 會忽略該欄位並回退到下方的 includePath。
  "version": 4,
  "configurations": [
    {
      "name": "Win32-MSVC",
      "includePath": [
        "${workspaceFolder}/include",
        "${workspaceFolder}/src"
      ],
      "defines": [
        "_WIN32",
        "UNICODE",
        "_UNICODE"
      ],
      "compilerPath": "C:/Program Files (x86)/Microsoft Visual Studio/2022/BuildTools/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/cl.exe",
      "compilerArgs": [
        "/utf-8"
      ],
      "cStandard": "c17",
      "cppStandard": "c++20",
      "intelliSenseMode": "windows-msvc-x64",
      "compileCommands": "${workspaceFolder}/build/ninja-x64/compile_commands.json"
    }
  ]
}
